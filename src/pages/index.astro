---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const species = [...new Set(penguins.map((penguin) => penguin.species))];
---

<Layout>
  <h1 class="mb-5 font-['Newsreader',Georgia,serif] text-[34px] font-semibold leading-[1.12] text-[#183d34] sm:text-[42px]">Pingouins</h1>
  {species.map((speciesName) => (
    <section class="mt-8 border-t border-[#d7e0d9] pt-6">
      <h2 class="mb-3.5 font-['Newsreader',Georgia,serif] text-[23px] font-semibold leading-tight text-[#183d34] sm:text-[26px]">{speciesName}</h2>
      <PlotFigure
        options={{
          marks: [
            Plot.dot(
              penguins.filter((penguin) => penguin.species === speciesName),
              {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
              },
            ),
          ],
        }}
      />
    </section>
  ))}
</Layout>
