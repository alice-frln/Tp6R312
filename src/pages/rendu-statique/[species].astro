---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";

export function getStaticPaths() {
  const species = [...new Set(penguins.map((penguin) => penguin.species))];

  return species.map((speciesName) => ({
    params: { species: speciesName },
  }));
}

const { species } = Astro.params;
const speciesPenguins = penguins.filter((penguin) => penguin.species === species);
---

<Layout>
  <h1 class="mb-5 font-['Newsreader',Georgia,serif] text-[34px] font-semibold leading-[1.12] text-[#183d34] sm:text-[42px]">{species}</h1>
  <PlotFigure
    options={{
      marks: [
        Plot.dot(speciesPenguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
        }),
      ],
    }}
  />
</Layout>