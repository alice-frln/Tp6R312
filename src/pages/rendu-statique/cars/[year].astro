---
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import carsCsv from "../../../assets/cars.csv?raw";
import { autoType, csvParse } from "d3-dsv";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

const cars = csvParse(carsCsv, autoType);

export function getStaticPaths() {
  const cars = csvParse(carsCsv, autoType);
  const years = [...new Set(cars.map((car) => car.year))].sort();

  return years.map((year) => ({
    params: { year: year.toString() },
  }));
}

const { year } = Astro.params;
const filteredCars = cars.filter((car) => car.year.toString() === year);

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredCars, {
      x: "weight (lb)",
      y: "power (hp)",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
    }),
  ],
  x: {
    label: "Poids (lb)",
  },
  y: {
    label: "Puissance (hp)",
  },
  title: `Relation Puissance vs Poids - Voitures ${year}`,
};
---

<Layout>
  <h1 class="mb-5 font-['Newsreader',Georgia,serif] text-[34px] font-semibold leading-[1.12] text-[#183d34] sm:text-[42px]">Voitures de l'année {year}</h1>
  <p class="mb-4 max-w-[72ch] text-[#60726a]">{filteredCars.length} voiture(s) trouvée(s) pour l'année {year}</p>
  <PlotFigure options={plotOptions} />
</Layout>